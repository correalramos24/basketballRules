---
import ThemeToggle from './ThemeToggle.astro';
import SearchIsland from './SearchIsland.astro';
import DocSwitcher from './DocSwitcher.astro';

const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'Inici' },
  { href: '/quant-a', label: 'Quant a' },
];

// The document switcher only makes sense inside a document.
const inDocument = /^\/(articles|interpretacions)\//.test(path);

const isActive = (href) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  class="sticky top-0 z-20 border-b border-court-200 bg-white/80 backdrop-blur dark:border-court-700 dark:bg-court-800/80"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <div class="flex min-w-0 items-center gap-3">
      <a href="/" class="flex shrink-0 items-center gap-2 font-semibold">
        <span class="grid h-8 w-8 place-items-center rounded-full bg-accent text-xs font-bold text-white">
          FIBA
        </span>
        <span class:list={[inDocument && 'hidden md:inline']}>Reglament 2026</span>
      </a>
      {inDocument && <DocSwitcher />}
    </div>

    <div class="flex items-center gap-2">
      <nav class="flex items-center gap-1 text-sm">
        {links.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-1.5 transition',
              isActive(href)
                ? 'bg-accent/10 font-medium text-accent'
                : 'hover:bg-court-100 dark:hover:bg-court-700',
            ]}
          >
            {label}
          </a>
        ))}
      </nav>
      <SearchIsland />
      <ThemeToggle />
    </div>
  </div>
</header>
