---
interface Props {
  label?: string;
}

const { label = 'Tornar' } = Astro.props;
---

<a
  href="/"
  title="Tornar a la pàgina principal"
  class="inline-flex items-center gap-1.5 rounded-lg border border-court-200 bg-white px-3 py-1.5 text-sm font-medium transition hover:border-accent hover:text-accent dark:border-court-700 dark:bg-court-800"
>
  <span aria-hidden="true">←</span>
  {label}
</a>

