---
import Base from './Base.astro';
import ArticleSidebar from '../components/ArticleSidebar.astro';
import BackLink from '../components/BackLink.astro';

interface Props {
  slug: string;
  numero: number | string;
  titulo: string;
  /** Which document the page belongs to; picks the sidebar's list and the page title. */
  doc?: 'reglament' | 'interpretacions';
}

const { slug, numero, titulo, doc = 'reglament' } = Astro.props;
const artClass = `art-${String(numero).padStart(2, '0')}`;
const docTitle = doc === 'interpretacions' ? 'Interpretacions 2026' : 'Reglament 2026';
---

<Base title={`Art. ${numero} ${titulo} — ${docTitle}`}>
  <div class="lg:grid lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-10">
    <ArticleSidebar current={slug} doc={doc} />

    <div class="min-w-0">
      <div class="mb-4">
        <BackLink />
      </div>

      <header class="mb-8 border-b border-court-200 pb-4 dark:border-court-700">
        <h1 class="text-3xl font-bold tracking-tight">
          <span class="font-mono">Art. {numero}</span> — {titulo}
        </h1>
      </header>

      <article class={`${artClass} prose prose-court max-w-none dark:prose-invert`}>
        <slot />
      </article>
    </div>
  </div>
</Base>
