---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.numero - b.data.numero,
);
---

<Base title="Índex d'articles — Reglament 2026">
  <h1 class="mb-6 text-2xl font-bold">Índex d’articles</h1>
  <ol class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
    {articles.map((a) => (
      <li>
        <a
          href={`/articles/${a.id}`}
          class="flex items-baseline gap-2 rounded-lg border border-court-200 bg-white px-3 py-2 text-sm transition hover:border-accent hover:shadow-sm dark:border-court-700 dark:bg-court-800"
        >
          <span class="font-mono text-xs text-accent">{a.data.numero}</span>
          <span>{a.data.titulo}</span>
          <span class="ml-auto font-mono text-[10px] text-court-400">R{a.data.regla}</span>
        </a>
      </li>
    ))}
  </ol>
</Base>
